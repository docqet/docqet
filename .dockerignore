# Version control and CI config: not needed to build or run the image.
.git/
.github/

# Local compose overrides.
compose.override.yml

# Build and coverage output.
/bin/
/docket
coverage.*

# The docs linter's dependencies, which the image doesn't use.
/node_modules/

# The UI's dependencies and build, which the image installs and builds itself.
ui/node_modules/
ui/dist/

# Docs and examples: not part of the image. Only the parts of the spec the
# binary embeds are kept.
docs/
examples/
spec/*
!spec/spec.go
!spec/stability/
