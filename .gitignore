# Test binaries, built with `go test -c`, and coverage profiles.
*.test
*.out
coverage.*

# Go workspace files.
go.work
go.work.sum

# env file
.env

# Local compose override
compose.override.yml

# Build output, from `go build -o bin/ ./cmd/docket`.
/bin/

# Docket's own state, from `docket index` at the root. The examples' state.json
# files are written by hand, so they're kept.
/.docket/

# The local server's SQLite database, from `make run`.
/data/

# The docs linter's dependencies, from the root package.json.
node_modules/

# Snapshots, screenshots and console logs the Playwright MCP server writes.
.playwright-mcp/
